# Copiar a .env antes de levantar el proyecto:
#   cp .env.example .env
# .env NO se versiona (ver .gitignore). Los valores de este archivo son
# ficticios: cambie la contraseña en cualquier entorno distinto al laboratorio.

# Base de datos PostgreSQL (servicio db)
DB_NAME=appdb
DB_USER=postgres
DB_ADMIN_PASSWORD=cambiar_esta_clave

# Conexión de la API a la base de datos por la red interna de Docker
DB_HOST=db
DB_PORT=5432
