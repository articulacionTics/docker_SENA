# Copiar a .env antes de levantar el proyecto:
#   cp .env.example .env
# .env NO se versiona (ver .gitignore). Cambie la contraseña en cualquier
# entorno distinto al laboratorio local.

# PostgreSQL (servicio db)
POSTGRES_DB=labdb
POSTGRES_USER=labuser
POSTGRES_PASSWORD=cambiar_esta_clave

# Conexión de la API a la base de datos (red interna Docker)
DB_HOST=db
DB_PORT=5432
